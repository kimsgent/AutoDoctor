{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build AutoDoctor Installer (venv)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/installer/Build-AutoDoctor.ps1",
        "-PythonExe",
        "${workspaceFolder}/server/api/.venv/Scripts/python.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Build AutoDoctor (Skip Installer, venv)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/installer/Build-AutoDoctor.ps1",
        "-SkipInstaller",
        "-PythonExe",
        "${workspaceFolder}/server/api/.venv/Scripts/python.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
